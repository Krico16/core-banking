{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking.local/schemas/events/payment-risk-evaluation-requested.json",
  "title": "PaymentRiskEvaluationRequested",
  "type": "object",
  "required": ["paymentId", "sourceAccountId", "targetAccountId", "amount", "currency", "requestedAt"],
  "description": "sourceCustomerId/targetCustomerId are omitted by payment-service today — it only tracks account IDs, not the owning customer IDs (would require a call to account-service it doesn't currently make). risk-service treats them as optional.",
  "properties": {
    "paymentId": { "type": "string" },
    "sourceCustomerId": { "type": ["string", "null"] },
    "targetCustomerId": { "type": ["string", "null"] },
    "sourceAccountId": { "type": "string" },
    "targetAccountId": { "type": "string" },
    "amount": { "type": "integer" },
    "currency": { "type": "string" },
    "requestedAt": { "type": "string", "format": "date-time" }
  }
}
