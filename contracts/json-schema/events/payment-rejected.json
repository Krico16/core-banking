{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking.local/schemas/events/payment-rejected.json",
  "title": "PaymentRejected",
  "type": "object",
  "required": ["paymentId", "idempotencyKey", "sourceAccountId", "targetAccountId", "amount", "currency", "initiatedBy", "status", "createdAt", "updatedAt"],
  "properties": {
    "paymentId": { "type": "string" },
    "idempotencyKey": { "type": "string" },
    "sourceAccountId": { "type": "string" },
    "targetAccountId": { "type": "string" },
    "amount": { "type": "integer", "description": "Monto en centavos" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "description": { "type": ["string", "null"] },
    "initiatedBy": { "type": "string" },
    "status": { "type": "string" },
    "ledgerEntryId": { "type": ["string", "null"] },
    "failureReason": { "type": ["string", "null"] },
    "reason": { "type": "string", "description": "Motivo de rechazo de riesgo (p.ej. AMOUNT_EXCEEDS_DAILY_LIMIT)" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "reversedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
