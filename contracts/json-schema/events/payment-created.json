{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking.local/schemas/events/payment-created.json",
  "title": "PaymentCreated",
  "type": "object",
  "required": ["paymentId", "idempotencyKey", "sourceAccountId", "targetAccountId", "amount", "currency", "description", "initiatedBy", "createdAt"],
  "properties": {
    "paymentId": { "type": "string" },
    "idempotencyKey": { "type": "string" },
    "sourceAccountId": { "type": "string" },
    "targetAccountId": { "type": "string" },
    "amount": { "type": "integer", "description": "Monto en centavos" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "description": { "type": "string" },
    "initiatedBy": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
