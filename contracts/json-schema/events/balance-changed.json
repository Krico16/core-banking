{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking.local/schemas/events/balance-changed.json",
  "title": "AccountBalanceChanged",
  "type": "object",
  "required": ["accountId", "previousBalance", "newBalance", "delta", "currency", "entryId", "changedAt"],
  "properties": {
    "accountId": { "type": "string" },
    "previousBalance": { "type": "integer" },
    "newBalance": { "type": "integer" },
    "delta": { "type": "integer" },
    "currency": { "type": "string" },
    "entryId": { "type": "string" },
    "changedAt": { "type": "string", "format": "date-time" }
  }
}
