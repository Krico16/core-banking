{
  "name": "@banking/e2e-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Suite de tests E2E black-box contra el stack completo, vía api-gateway",
  "scripts": {
    "test": "jest --runInBand",
    "seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.e2e-spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 120000
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
